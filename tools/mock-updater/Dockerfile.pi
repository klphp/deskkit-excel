# 树莓派/armv7 运行镜像：只放预编译二进制，不在设备上编译 Go。
#
# 用法（在控制端）：
#   CGO_ENABLED=0 GOOS=linux GOARCH=arm GOARM=7 go build -trimpath -ldflags "-w -s" \
#     -o /tmp/pi-mock/mock-updater-linux-armv7 ./tools/mock-updater
#   scp /tmp/pi-mock/mock-updater-linux-armv7 pi@<pi-host>:~/deskkit-mock/
#   scp tools/mock-updater/Dockerfile.pi pi@<pi-host>:~/deskkit-mock/Dockerfile
#
# 在派上：
#   cd ~/deskkit-mock && sudo docker build -t deskkit/mock-updater:pi .
#   sudo docker run -d --name deskkit-mock --restart unless-stopped -p 8790:8790 \
#     -e MOCK_VERSION=9.9.9 -e MOCK_PUBLIC_URL=http://<pi-host>:8790 \
#     deskkit/mock-updater:pi
#
# 两个坑（都踩过）：
#   ① 容器里必须监听 0.0.0.0；绑 127.0.0.1 时端口映射打不进来（--bind 默认已是 0.0.0.0）
#   ② MOCK_PUBLIC_URL 必须是局域网 IP，填 127.0.0.1 时 Mac / Windows 都取不到资产
FROM alpine:3.20
RUN adduser -D -u 10001 mock && mkdir -p /data && chown mock /data
COPY mock-updater-linux-armv7 /usr/local/bin/mock-updater
RUN chmod +x /usr/local/bin/mock-updater
USER mock
WORKDIR /data
ENV MOCK_VERSION=9.9.9 \
    MOCK_PORT=8790 \
    MOCK_PUBLIC_URL="" \
    MOCK_PLATFORMS=windows/amd64,darwin/amd64,darwin/arm64
EXPOSE 8790
CMD ["sh","-c","exec mock-updater --version \"$MOCK_VERSION\" --port \"$MOCK_PORT\" --dir /data --public-url \"$MOCK_PUBLIC_URL\" --platforms \"$MOCK_PLATFORMS\""]
